// Expression
Compound   = Line_String
           | slice_lit
           | map_lit
           | object_lit
           | Expr
           ;
Expr       = or;
or         = and { "or" and };
and        = eq { "and" eq };
eq         = comparison { ( "!=" | "==" ) comparison };
comparison = Term { ( ">" | ">=" | "<" | "<=" ) } Term;
Term       = factor { ( "-" | "+" ) factor };
factor     = unary { ( "*" | "/" | "%" ) unary };
unary      = ( "-" | "." ) Primary | Member;
Member     = Call { "." Call };
Call       = Primary "(" call_arg ")" | Primary;
Primary    = "currentcolor"
           | "nil"
           | "_"
           | bool
           | Quoted_String
           | keyword
           | number
           | size
           | color_hex
           | Ident
           | Ident_Dash
           | "(" or ")"
           ;
bool       = "true" | "false";
keyword    = "'" Ident "'";

// Slice & Map Literals
slice_lit     = Slice_Type "{" [ expr_list [ "," ] ] "}";
map_lit       = Map_Type "{" [ map_entries [ "," ] ] "}";
map_entries   = map_entry { "," map_entry };
map_entry     = Expr "=" Expr;
object_lit    = Qual_Ident "{" { object_fields } "}";
object_fields = entry;
expr_list     = Expr { "," Expr };

// Type
type       = qual_ident
           | slice_type
           | map_type
           ;
slice_type = "[" "]" type;
map_type   = "map" "[" type "]" type;
qual_ident = Ident "." Ident
           | Ident
           ;

call_arg   = arg_list | entry_list;
arg_list   = Expr { [ "," ] Expr };
entry_list = entry { [ "," ] entry };

// Identifier
Ident      = '[a-zA-Z_][a-zA-Z0-9_]*';
Ident_Dash = '(--)?[a-zA-Z_-][a-zA-Z0-9_-]*';

// Number
digit_hex  = '[a-fA-F0-9]';
digit_bin  = "0" | "1";
integer    = '[1-9]';
number_bin = ( "0b" | "0B" ) digit_bin { digit_bin };
number_hex = ( "0x" | "0X" ) digit_hex { digit_hex };
number_dec = "0" | integer [ "." ( "0" | integer ) ];
number     = number_dec
           | number_hex
           | number_bin
           ;

// Size and color
color_hex = "#" digit_hex { digit_hex };
size      = number unit;
unit      = "%" | "px" | "ch" | "em" | "rem";

// String & String line
String          = Quoted_String | Line_String;
Quoted_String   = "\"" { string_content } "\"";
line_string     = "\\" { string_content };
Line_String     = line_string { line_string };
string_content  = escape_char
                | string_template
                | '[^\n"]'
                ;
string_template = "\\{" Expr "}";
escape_char     = '\\["trsfvn]';

Comment = '//[^\n]*[\n]?';

// Tag
Tag   = '.*';
entry = Ident "=" Expr;
