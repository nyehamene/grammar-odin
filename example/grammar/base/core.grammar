// Expression
Compound   = string_lines
           | slice_lit
           | map_lit
           | object_lit
           | expr
           ;
expr       = or;
or         = and { "or" and };
and        = eq { "and" eq };
eq         = comparison { ( "!=" | "==" ) comparison };
comparison = term { ( ">" | ">=" | "<" | "<=" ) } term;
term       = factor { ( "-" | "+" ) factor };
factor     = unary { ( "*" | "/" | "%" ) unary };
unary      = ( "-" | "." ) primary | member;
member     = call { "." call };
call       = primary "(" call_arg ")" | primary;
primary    = "currentcolor"
           | "nil"
           | "_"
           | bool
           | string
           | keyword
           | number
           | size
           | color_hex
           | ident
           | ident_dash
           | "(" or ")"
           ;
bool       = "true" | "false";
keyword    = "'" ident "'";

// Slice & Map Literals
slice_lit     = slice_type "{" [ expr_list [ "," ] ] "}";
map_lit       = map_type "{" [ map_entries [ "," ] ] "}";
map_entries   = map_entry { "," map_entry };
map_entry     = expr "=" expr;
object_lit    = qual_ident "{" { object_fields } "}";
object_fields = entry;
expr_list     = expr { "," expr };

// Type
type       = qual_ident
           | slice_type
           | map_type
           ;
slice_type = "[" "]" type;
map_type   = "map" "[" type "]" type;
qual_ident = ident "." ident
           | ident
           ;

call_arg   = arg_list | entry_list;
arg_list   = expr { [ "," ] expr };
entry_list = entry { [ "," ] entry };

// Identifier
ident      = /[a-zA-Z_][a-zA-Z0-9_]*/;
ident_dash = /(--)?[a-zA-Z_-][a-zA-Z0-9_-]*/;

// Number
digit_hex  = /[a-fA-F0-9]/;
digit_bin  = "0" | "1";
integer    = /[1-9]/;
number_bin = ( "0b" | "0B" ) digit_bin { digit_bin };
number_hex = ( "0x" | "0X" ) digit_hex { digit_hex };
number_dec = "0" | integer [ "." ( "0" | integer ) ];
number     = number_dec
           | number_hex
           | number_bin
           ;

// Size and color
color_hex = "#" digit_hex { digit_hex };
size      = number unit;
unit      = "%" | "px" | "ch" | "em" | "rem";

// String & String line
string          = "\"" { string_content } "\"";
string_line     = "\\" { string_content };
string_lines    = string_line { string_line };
string_content  = escape_char
                | string_template
                | /[^\n"]/
                ;
string_template = "\\{" expr "}";
escape_char     = /\\[\\\s"trsfvn]/;

// Tag
Tag   = "`" /.*/ "`";
entry = ident "=" expr;

// Statement sep & comment
// Supports automatic semicolon insertion on newline
Separator = ";";
Comment   = "//" /[^\n]*[\n]?/;
