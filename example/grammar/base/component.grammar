core  = @import("core.grammar");
style = @import("style.grammar");

// Component
Component       = "component" [ component_arg ] component_block;
component_arg   = "(" core.ident ":" core.type ")";
component_block = "{" { component_field } [ component_body ] "}";
component_field = field sep;
component_body  = elements;
field           = core.ident ( field_type | field_init ) [ field_tag ];
field_init      = ( var_type | ":" ) ( ":" | "=" ) expr;
field_type      = ":" core.type;
field_tag       = core.Tag;

// Element
element           = string_element
                  | text_element
                  | component_element
                  ;
string_element    = core.string
                  | core.string_lines
                  ;
text_element      = "[" "_" core.ident "]";
component_element = "[" component_tag [ component_body ] "]";
component_tag     = core.expr;
component_body    = core.ident | children;
children          = child { child };
child             = attribute_group
                  | inline_style
                  | element
                  ;

inline_style          = [ field_selector ] "style" [ pseudo_selector_group ] style.block;
pseudo_selector_group = "(" pseudo_selector { "," pseudo_selector } [ "," ] ")";
pseudo_selector       = ":" [ ":" ] ( core.ident_dash | core.ident );

field_selector = "@" qual_ident;
elements       = element { element };
qual_ident     = ident { "." ident };

// Attribute
attribute_group           = qualified_attribute_group
                          | named_attribute_group
                          | attribute_block
                          ;
qualified_attribute_group = attribute_qualifier attribute_block;
attribute_qualifier       = field_selector [ "::" ident ];
named_attribute_group     = ident attribute_block;
attribute_block           = "{}" | "{" attributes [ "," ] "}";
attributes                = attribute { "," attribute };
attribute                 = attribute_key [ "=" attribute_value ];
attribute_key             = core.ident
                          | core.ident_dash
                          | core.string
                          ;
attribute_value           = if
                          | cond
                          | expr
                          ;

if            = "if" expr "then" expr [ else ];
else          = "else" ( if | expr );
cond          = "cond" expr "{" case { case } [ case_default ] "}";
case          = "case" case_selector "=" expr sep;
case_default  = "case" "=" expr sep;
case_selector = ident ":" qual_ident
              | primary
              ;
// Expression
expr          = core.expr;
sep           = core.Separator;
