core      = @import("core.grammar");
component = @import("component.grammar");

Stmt           = expr_stmt
               | block
               | if
               | cond
               | foreach
               | element
               ;
stmts          = Stmt { sep Stmt } sep;
expr_stmt      = core.expr sep;
block          = "{" stmts "}" sep;
if             = "if" expr block [ else ] sep;
else           = "else" ( if | block );
cond           = "cond" expr "{" case { case } "}" sep;
case           = case_branch | case_default;
case_branch    = "case" component.case_selector "=" stmts;
case_default   = "case" "=" stmts;
foreach        = "foreach" foreach_header block;
foreach_header = core.ident [ "," core.ident ] "in" expr;
sep            = core.separator;
