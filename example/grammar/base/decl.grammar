core      = @import("core.grammar");
style     = @import("style.grammar");
component = @import("component.grammar");

Var      = core.ident ( var_type | var_init );
var_init = ( var_type | ":" ) ( ":" | "=" ) expr;
var_type = ":" core.type;
expr     = enum
         | union
         | component.Component
         | style.Rule
         | core.expr
         ;

Doc              = core.ident ":" ( core.string | core.string_lines );
Api              = core.ident ":" ( api_public | api_private );
api_public       = "@public" [ "()" ];
api_private      = "@private" [ "(" api_private_mode ")" ];
api_private_mode = /"file"/ | /"package"/;

Import  = core.ident ":" import;
import  = "@import" "(" core.string ")";
require = "@require" "(" core.string ")";
include = "@include" "(" core.string ")";

Style = core.ident ":" "@" style.Rule;

// Union
union    = "union" "{" variants "}";
variants = variant { variant };
variant  = core.qual_ident sep;

// Enumeration
enum         = "enum" "{" [ enum_members ] "}";
enum_members = enum_member { enum_member };
enum_member  = ident [ "=" core.primary ] sep;
