// css
Rule        = "style" "(" [ _params ] [ "," ] ")" _block;
_params     = _param { "," _param };
_param      = Ident ( _param_type | _param_init ) [ Tag ];
_param_type = ":" Type;
_param_init = ( _param_type | ":" ) "=" Expr;

_block       = <Block _stmts>;
_stmts       = _stmt { _stmt };
_stmt        = _decl ";"
             | _if_stmt ";"
             | _cond_stmt ";"
             | _field_style ";"
             ;
_decl        = _property;
_property    = Ident ":" _value [ "!important" ];
_field_style = "self" "." Member _block;

// style value
_value      = _list { _list };
_list       = _slash_list { _slash_list };
_slash_list = _comma_list { "/" _comma_list };
_comma_list = _term { "," _term };
_term       = _calc | Term;
_calc       = "calc" "(" _list ")";

_if_stmt    = <If _expr _stmt>;
_cond_stmt  = <Cond _expr _stmt>;
Style_Block = _block;
_expr       = Expr;
