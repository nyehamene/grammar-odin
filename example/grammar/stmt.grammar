Block stmt          = "{" <One_Or_More stmt> "}" Sep;
If expr stmt        = "if" expr <Block stmt> [ <else expr stmt> ] Sep;
else expr stmt      = "else" <If expr stmt>
                    | "else" <Block stmt>
                    ;
Cond expr stmt      = "cond" expr "{"
                    <case stmt> { <case stmt> } "}"
                    [ <default stmt> ]
                    Sep
                    ;
case stmt           = "case" Case_Selector "=" <One_Or_More stmt>;
default stmt        = "case" "=" <One_Or_More stmt>;
Case_Selector       = Ident ":" Qual_Ident
                    | Primary
                    ;
Foreach expr stmt   = "foreach" <foreach_header expr> <Block stmt>;
foreach_header expr = Ident [ "," Ident ] "in" expr;

// function
One_Or_More val = val { Sep val } Sep;

Sep = ";";
