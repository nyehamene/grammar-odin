Var       = Ident ( _var_type | _var_init );
_var_init = ( _var_type | ":" ) ( ":" | "=" ) _expr ";";
_var_type = ":" Type;
_expr     = Enum
          | Union
          | Component | Rule
          | Compound;

Doc               = Ident ":" ( Quoted_String | Line_String );
Api               = Ident ":" ( _api_public | _api_private );
_api_public       = "@public" [ "()" ];
_api_private      = "@private" [ "(" _api_private_mode ")" ];
_api_private_mode = '"file"' | '"package"';

Import  = Ident ":" _import;
_import = "@import" "(" Quoted_String ")";
Require = "@require" "(" Quoted_String ")";
Include = "@include" "(" Quoted_String ")";

Style = Ident "::" Rule;

// Union
Union     = "union" "{" _variants "}";
_variants = _variant { _variant };
_variant  = Qual_Ident Sep;

// Enumeration
Enum          = "enum" "{" [ _enum_members ] "}";
_enum_members = _enum_member { _enum_member };
_enum_member  = Ident [ "=" Primary ] Sep;

// Component
Component        = "component" [ _component_param ] _component_body;
_component_param = "(" Ident ":" Type ")";
_component_body  = "{" { Field } [ Element_Children ] "}";
Field            = _field Sep;
_field           = Ident ( _field_type | _field_init ) [ _field_tag ];
_field_init      = ( _var_type | ":" ) ( ":" | "=" ) Primary;
_field_type      = _var_type;
_field_tag       = Tag;

